# Copy to .env and adjust. .env is gitignored.

# Pinned Superset image tag (must have a matching Docker Hub tag).
SUPERSET_VERSION=6.0.0

# Host port to expose the Superset UI on.
SUPERSET_PORT=8088

# Flask secret key — generate with: openssl rand -base64 42
SECRET_KEY=change-me-openssl-rand-base64-42

# Superset metadata Postgres
POSTGRES_DB=superset
POSTGRES_USER=superset
POSTGRES_PASSWORD=superset

# Initial admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com
ADMIN_FIRSTNAME=Superset
ADMIN_LASTNAME=Admin
